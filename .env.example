# Copy to .env and fill in from Supabase Dashboard > Settings > API
# Leave blank to run with local browser storage only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: live flight schedules for Transit → Estimate time / find flights
# Without this key the app uses distance estimates + a Google Flights link.
# https://aviationstack.com (free tier)
VITE_AVIATIONSTACK_KEY=

# Optional: Google Maps / Places (client). When set, geocoding & POI search use Google.
# Without it, Leaflet + OSM / Nominatim / Overpass stay as today.
VITE_GOOGLE_MAPS_API_KEY=

# Local-part shown in Advanced settings forward address: {user}+{token}@gmail.com
# Must match Supabase secret BOOKING_GMAIL_USER used by poll-gmail-inbox.
VITE_BOOKING_GMAIL_USER=bookings
