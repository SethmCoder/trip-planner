# Copy to .env and fill in from Supabase Dashboard > Settings > API
# Leave blank to run with local browser storage only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: live flight schedules for Transit → Estimate time / find flights
# Without this key the app uses distance estimates + a Google Flights link.
# https://aviationstack.com (free tier)
VITE_AVIATIONSTACK_KEY=
